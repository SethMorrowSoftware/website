# ============================================================
# Business Website CMS — Environment Configuration
# ============================================================
# Copy this file to .env and update values for your environment.
# All values here can override config.php defaults.

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=business_cms
DB_USER=root
DB_PASS=

# Site URL (used for payment callbacks, emails, etc.)
# Leave empty for auto-detection from request
SITE_URL=

# Application
APP_DEBUG=0
APP_ENV=production

# Mail (optional — falls back to PHP mail())
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Stripe
STRIPE_ENABLED=0
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_ENABLED=0
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_SANDBOX=1

# Square
SQUARE_ENABLED=0
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_SANDBOX=1

# BTCPay
BTCPAY_ENABLED=0
BTCPAY_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=

# CDN (optional — prefix for static assets)
CDN_BASE_URL=

# Trusted Proxy (for apps behind load balancers)
TRUSTED_PROXY_ENABLED=0
TRUSTED_PROXY_IPS=
